# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/messaging?schema=public

# Optional dedicated URL for automated tests (defaults to messaging_test on same host)
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/messaging_test?schema=public


# Comma-separated trusted CORS origins (use * only for local demos)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional shared secret for provider webhooks (x-webhook-secret header)
# Leave empty to disable webhook secret checks (development only)
WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
